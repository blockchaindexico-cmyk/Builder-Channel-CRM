// M01 — Platform core: tenant root, settings, sequences, audit log, outbox, files, worker heartbeat.

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// Tenant root. Exactly one organization exists in single-tenant mode; the model is multi-tenant ready.
model Organization {
  id        String             @id @default(uuid(7)) @db.Uuid
  name      String
  /// Globally unique tenant identifier (future subdomain). Exception to rule T2, like User.email.
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings            OrganizationSetting?
  sequences           Sequence[]
  auditLogs           AuditLog[]
  outboxEvents        OutboxEvent[]
  files               FileObject[]
  roles               Role[]
  rolePermissions     RolePermission[]
  memberships         Membership[]
  // M03
  propertyTypes       PropertyType[]
  configurationTypes  ConfigurationType[]
  amenities           Amenity[]
  builders            Builder[]
  // M04
  leadSources         LeadSource[]
  campaigns           Campaign[]
  leadStatuses        LeadStatus[]
  leads               Lead[]
  savedViews          SavedView[]
  leadImports         LeadImportBatch[]
  apiKeys             ApiKey[]
  // M05
  leadAssignments     LeadAssignment[]
  reassignmentReasons ReassignmentReason[]
  assignmentRules     AssignmentRule[]
  // M06
  notifications       Notification[]
  scheduledReminders  ScheduledReminder[]
  announcements       Announcement[]
  callOutcomes        CallOutcome[]
  callLogs            CallLog[]
  followUpPurposes    FollowUpPurpose[]
  followUps           FollowUp[]
  // M08
  visitOutcomes       VisitOutcome[]
  siteVisits          SiteVisit[]
  lossReasons         LossReason[]
  bookingStages       BookingStage[]
  bookings            Booking[]
  // M09
  commissionTerms     CommissionTerm[]
  dealFinancials      DealFinancial[]
  invoices            Invoice[]
  businessExpenses    BusinessExpense[]

  @@map("organizations")
}

/// Per-organization settings (T6). Typed columns for common settings; `preferences` holds
/// module-specific settings validated by each module's zod schema.
model OrganizationSetting {
  organizationId       String       @id @map("organization_id") @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName            String?      @map("legal_name")
  logoFileId           String?      @map("logo_file_id") @db.Uuid
  email                String?
  phone                String?
  website              String?
  addressLine1         String?      @map("address_line1")
  addressLine2         String?      @map("address_line2")
  city                 String?
  state                String?
  postalCode           String?      @map("postal_code")
  /// ISO 3166-1 alpha-2 country code; also the default region for phone number parsing.
  country              String       @default("IN")
  /// IANA timezone used for display and date bucketing.
  timezone             String       @default("Asia/Kolkata")
  /// ISO 4217 currency code.
  currency             String       @default("INR")
  /// BCP 47 locale used for number/date formatting.
  locale               String       @default("en-IN")
  /// date-fns format pattern.
  dateFormat           String       @default("dd MMM yyyy") @map("date_format")
  /// 1 = January … 12 = December (April for Indian fiscal years).
  fiscalYearStartMonth Int          @default(4) @map("fiscal_year_start_month")
  /// 0 = Sunday … 6 = Saturday.
  weekStartsOn         Int          @default(1) @map("week_starts_on")
  preferences          Json         @default("{}")
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("organization_settings")
}

/// Per-organization counters for human-readable numbers (T7), e.g. LD-000123.
model Sequence {
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  lastValue      Int          @default(0) @map("last_value")
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, key])
  @@map("sequences")
}

enum ActorType {
  USER
  SYSTEM
  API_KEY
}

/// Accountability trail for important mutations (PRD §28). Written in the same transaction as the change.
model AuditLog {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorType      ActorType    @default(USER) @map("actor_type")
  actorId        String?      @map("actor_id") @db.Uuid
  /// Display name of the actor at the time of the action.
  actorName      String?      @map("actor_name")
  /// Dotted action key, e.g. "organization.settings.update".
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  summary        String?
  /// Field-level diff: { field: { from, to } }.
  changes        Json?
  metadata       Json?
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  requestId      String?      @map("request_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Transactional outbox / domain event log. Each row is written in the same transaction as the change
/// that produced it; handler jobs are enqueued in that same transaction (see platform/events).
model OutboxEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  payload        Json
  actorType      ActorType    @default(SYSTEM) @map("actor_type")
  actorId        String?      @map("actor_id") @db.Uuid
  actorName      String?      @map("actor_name")
  requestId      String?      @map("request_id")
  /// Names of the handlers the event was dispatched to.
  dispatchedTo   String[]     @map("dispatched_to")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, type, occurredAt(sort: Desc)])
  @@index([occurredAt])
  @@map("outbox_events")
}

enum FileStatus {
  PENDING
  READY
  DELETED
}

/// Metadata for every stored file. Object keys are prefixed `orgs/{organizationId}/` (T8).
model FileObject {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Registered purpose (e.g. "organization.logo"), which defines size/type limits and access rules.
  purpose        String
  key            String       @unique
  fileName       String       @map("file_name")
  contentType    String       @map("content_type")
  /// Declared size at upload request time; verified against the stored object on completion.
  size           Int
  status         FileStatus   @default(PENDING)
  uploadedById   String?      @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  projectFiles ProjectFile[]
  builderFiles BuilderFile[]
  leadFiles    LeadFile[]
  callLogs     CallLog[]
  bookingFiles BookingFile[]
  invoicePdfs  Invoice[]

  @@unique([organizationId, id])
  @@index([organizationId, purpose, createdAt(sort: Desc)])
  @@map("file_objects")
}

/// Liveness record written by the background worker; reported by /api/health. Platform-level (not tenant-owned).
model WorkerHeartbeat {
  id         String   @id
  hostname   String
  pid        Int
  startedAt  DateTime @map("started_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)
  info       Json     @default("{}")

  @@map("worker_heartbeats")
}

/// Fixed-window request counters (API rate limits), shared by all web instances.
model RateLimitWindow {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("rate_limit_windows")
}

/// Key for the public API `/api/v1` (M04-20, first used by lead intake). Only a SHA-256 hash is stored; the key is
/// shown once.
model ApiKey {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  /// First characters of the key, shown to recognise it (e.g. "crm_7f3a9c1d").
  prefix          String
  hashedKey       String       @unique @map("hashed_key")
  /// Lead source applied when a request does not name one.
  defaultSourceId String?      @map("default_source_id") @db.Uuid
  lastUsedAt      DateTime?    @map("last_used_at") @db.Timestamptz(3)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdById     String?      @map("created_by_id") @db.Uuid
  createdByName   String       @map("created_by_name")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  idempotencyKeys ApiIdempotencyKey[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("api_keys")
}

/// Stored responses for `Idempotency-Key` retries (kept 24 hours).
model ApiIdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  apiKeyId       String   @map("api_key_id") @db.Uuid
  apiKey         ApiKey   @relation(fields: [organizationId, apiKeyId], references: [organizationId, id], onDelete: Cascade)
  key            String
  requestHash    String   @map("request_hash")
  /// Null while the first request with this key is still being processed.
  statusCode     Int?     @map("status_code")
  response       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([apiKeyId, key])
  @@index([createdAt])
  @@map("api_idempotency_keys")
}
