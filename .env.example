# ---------------------------------------------------------------------------
# Builder Channel CRM — environment variables
# Copy to `.env` for local development: `cp .env.example .env`
# All variables are validated at startup by src/config/env.ts.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public base URL of the web app (used in e-mails and absolute links).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Builder Channel CRM"
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# Used by the integration test suite (created by docker/postgres/init.sql).
TEST_DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_test
# Single-tenant mode: organization used until authentication (M02) resolves it from the session.
DEFAULT_ORGANIZATION_SLUG=default

# --- Authentication (Better Auth) -------------------------------------------------
# At least 32 characters. Generate a real one for every environment: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_RATE_LIMIT_ENABLED=true

# --- Seed data ------------------------------------------------------------------
SEED_ORGANIZATION_NAME="Demo Realty Partners"
SEED_ORGANIZATION_SLUG=default
# First administrator (created by `pnpm db:seed` if missing).
SEED_ADMIN_NAME="Asha Admin"
SEED_ADMIN_EMAIL=admin@demo-realty.test
SEED_ADMIN_PASSWORD=ChangeMe123!
# Also create demo manager/executive accounts (development only).
SEED_DEMO_USERS=true

# --- File storage (S3-compatible; RustFS in docker-compose) -----------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs given to browsers (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm-files
S3_ACCESS_KEY_ID=crm-access-key
S3_SECRET_ACCESS_KEY=crm-secret-key
S3_FORCE_PATH_STYLE=true

# --- E-mail -----------------------------------------------------------------------
# smtp | console | memory   (Mailpit catches SMTP mail locally: http://localhost:8025)
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Builder Channel CRM <no-reply@crm.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Background jobs (pg-boss) ------------------------------------------------------
JOBS_SCHEMA=pgboss
WORKER_CONCURRENCY=5

# --- Production only ------------------------------------------------------------------
# Stable key shared by all web instances so Server Action references stay valid across deploys.
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
